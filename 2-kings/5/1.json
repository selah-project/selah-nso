      "subject": "ונשא פנים",
      "rationale": "'Go phahamisa sepane' — idiom ya go tšewa ka tšhireletšo; ka Sepedi 'a kgethwa'."
    },
    {
      "kind": "addition",
      "subject": "ke",
      "rationale": "Sepedi e nyaka mošomi wa go ba gona; Seheberu se sa o se ngwale."
    },
