      "subject": "moedi wa Damaseke",
      "rationale": "Seripa sa go laola sekgoba sa dikgoro ka maina a mafelo le meedi."
    },
    {
      "kind": "substitution",
      "subject": "bodibela",
      "rationale": "הים seo se bolela 'lewatle' fela, eupša se šomišwa bjalo ka bodikela; Sepedi se ntšha sebopego sa lewatle."
    },
    {
      "kind": "idiom",
      "subject": "אל יד",
      "rationale": "'Go ya letseatleng la' — puo ya Seheberu ya go ba le kgauswi le selo, e sego seatla ka nnete."
    },
