    {
      "kind": "idiom",
      "subject": "dihla tša tau ke difašhe tša bona",
      "rationale": "Sesupo sa bogodi: banna ba šomago ntoa ba tšwa ba šomišitše tše makgwakgwa bjalo ka tau."
