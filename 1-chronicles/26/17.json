    {
      "kind": "idiom",
      "subject": "ליום",
      "rationale": "Sefoko sa Seheberu se bolela 'ka letšatši' — phetišetšo ya go šoma ya letšatši le letšatši, e sego tekanyo ya nako."
    },
    {
      "kind": "crux",
      "subject": "לאספים",
      "rationale": "'Dikopano' — bakae ba ba sego bonolo: KJV 'Asuppim' (leina), JPS 'Storehouse' (khotho); lentšu le bolela se kgobokeditšwego."
    }
  ],
