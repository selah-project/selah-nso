    {
      "kind": "idiom",
      "subject": "sebilo sa tlhohlelo ya Yahwe",
      "rationale": "Go nweng ga sebilong ke sebopego sa go welwa ke kahlolo; mantšu a re 'nwang, nwa go feta' ka tlwaelo e le kgalefo ya bokgalaka."
    }
