    {
      "kind": "wordplay",
      "subject": "איש אחד איש אחד",
      "rationale": "Go boelediša ga 'monna yo a tee, monna yo a tee' go latela mokgwa wa Seheberu wa go itiša ka bopelotumi; diphethollo tše dintši di phutholosa se go 'go e nngwe le go e nngwe' fela."
    },
    {
      "kind": "addition",
      "subject": "yo",
      "rationale": "Sepedi se nyaka 'yo' go tiiša go hlalosa ga 'monna' — Seheberu ga se na sona."
    }
