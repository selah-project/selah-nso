    {
      "kind": "wordplay",
      "subject": "חשך ואפלה \/ ענן וערפל",
      "rationale": "Phetišo ya mafoko a lefsifsi a piletšane: lefsifsi-bodikela, maru-lefsifsi le le bollela — sebopego se se phaseng se laleditšwego."
    },
    {
      "kind": "measurement",
      "subject": "mengwaga ya podišo e latelago podišo",
      "rationale": "Palo ya nako: go šala ga setšhaba se se tlaago go lekantšhwa go fihla mengwageng ya dipodišo tše di latelanago."
    }
