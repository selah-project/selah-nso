    {
      "kind": "wordplay",
      "subject": "כי...כי",
      "rationale": "כי ga bedi — go bolela gore 'ke tseba... ka gobane' — sebopego sa polelo ye, se se bolokwago ka Sepedi ka 'gore... ka gobane'."
    }
  ],
