    {
      "kind": "crux",
      "subject": "לקחת מתנות",
      "rationale": " O amogela dimpho (go tšwa go batho) kgathanong le o fa dimpho; Seheberu se bolela o amogela."
    },
    {
      "kind": "addition",
      "subject": "gona",
      "rationale": " Sepedi se nyaka lefelo la go dula; Seheberu se se na lona."
    }
